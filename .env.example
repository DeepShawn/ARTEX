# Docker 部署配置（复制为 .env）
APAGENT_IMAGE=ghcr.io/deepshawn/artex
APAGENT_TAG=v0.3.16
POSTGRES_USER=apagent
# 必填；建议使用随机字母数字密码，不能沿用示例密码。
POSTGRES_PASSWORD=
POSTGRES_DB=apagent

# 可选：覆盖应用连接串（例如密码含 URL 特殊字符时，填 URL 编码后的密码）。
# APAGENT_PG_DSN=postgres://apagent:encoded-password@postgres:5432/apagent?sslmode=disable

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
APAGENT_LLM_PROVIDER=
APAGENT_LLM_MODEL=
APAGENT_LLM_BASE_URL=
APAGENT_LLM_PROXY=
